  {
   "id": "vo0_of0_368",
   "en": "I'm glad you're safe. I shouldn't have worried.",
   "flags": [],
   "notes": ""
  },
  {
   "id": "vo0_of1_368",
   "en": "Women are strong, I guess. I'll learn from you.",
   "flags": [],
   "notes": ""
  },
  {
   "id": "vo0_of2_368",
   "en": "Good work. I'm just glad you made it back safe.",
   "flags": [],
   "notes": ""
  },
  {
   "id": "vo0_om0_368",
   "en": "Did you like my support?",
   "flags": [],
   "notes": ""
  },
  {
